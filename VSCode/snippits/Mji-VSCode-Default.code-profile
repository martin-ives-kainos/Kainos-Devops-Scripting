    "snippets": "{\"snippets\":{\"groovy.json\":\"{\\n\\t// Place your snippets for groovy here. Each snippet is defined under a snippet name and has a prefix, body and \\n\\t// description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:\\n\\t// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the \\n\\t// same ids are connected.\\n\\t// Example:\\n\\t// \\\"Print to console\\\": {\\n\\t// \\t\\\"prefix\\\": \\\"log\\\",\\n\\t// \\t\\\"body\\\": [\\n\\t// \\t\\t\\\"console.log('$1');\\\",\\n\\t// \\t\\t\\\"$2\\\"\\n\\t// \\t],\\n\\t// \\t\\\"description\\\": \\\"Log output to console\\\"\\n\\t// }\\n\\t\\\"UAE Settings Comment\\\":{\\n\\t\\t\\\"description\\\": \\\"Insert comment in Jenkins Groovy script\\\",\\n\\t\\t\\\"prefix\\\": \\\"uae_settings_comment\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"// TODO: UAE Specific Settings\\\",\\n\\t\\t\\t\\\"// ----------------------------------------------------------\\\",\\n\\t\\t\\t\\\"/*${TM_SELECTED_TEXT}*/\\\",\\n\\t\\t\\t\\\"// ----------------------------------------------------------\\\",\\n\\t\\t\\t\\\"\\\"\\n\\t\\t]\\n\\t},\\n\\t\\\"FileName_Comment\\\":{\\n\\t\\t\\\"description\\\": \\\"Inserts a comment with the full file path\\\",\\n\\t\\t\\\"prefix\\\": \\\"filenameComment\\\",\\n\\t\\t\\\"body\\\": \\\"// ${TM_FILEPATH}\\\"\\n\\t},\\n\\t\\\"echoMsg\\\":{\\n\\t\\t\\\"description\\\": \\\"Add echo line with file name in\\\",\\n\\t\\t\\\"prefix\\\": \\\"_echoMsg\\\",\\n\\t\\t\\\"body\\\": \\\"echo \\\\\\\"[${TM_FILENAME_BASE}] ${0:Message text}\\\\\\\" \\\"\\n\\t},\\n\\t\\\"TODO-CommentLine\\\":{\\n\\t\\t\\\"description\\\": \\\"Add a TODO comment line, areond selected text\\\",\\n\\t\\t\\\"prefix\\\": \\\"TODO_Line\\\",\\n\\t\\t\\\"body\\\": \\\"// TODO: ${0:Comment here} ${CURRENT_DATE}-${CURRENT_MONTH_NAME_SHORT}-${CURRENT_YEAR}\\\"\\n\\t}\\n}\",\"html.json\":\"{\\n\\t// Place your snippets for html here. Each snippet is defined under a snippet name and has a prefix, body and \\n\\t// description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:\\n\\t// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the \\n\\t// same ids are connected.\\n\\t// Example:\\n\\t// \\\"Print to console\\\": {\\n\\t// \\t\\\"prefix\\\": \\\"log\\\",\\n\\t// \\t\\\"body\\\": [\\n\\t// \\t\\t\\\"console.log('$1');\\\",\\n\\t// \\t\\t\\\"$2\\\"\\n\\t// \\t],\\n\\t// \\t\\\"description\\\": \\\"Log output to console\\\"\\n\\t// }\\n\\t\\\"cParagraph\\\": {\\n\\t\\t\\\"prefix\\\": \\\"cPara\\\",\\n\\t\\t\\\"description\\\": \\\"Encapsulate selected text in paragraph tags\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"<p>\\\",\\n\\t\\t\\t\\\"$TM_SELECTED_TEXT\\\",\\n\\t\\t\\t\\\"</p>\\\"\\n\\t\\t]\\n\\t},\\n\\t\\\"inParagraph\\\": {\\n\\t\\t\\\"prefix\\\": \\\"inPara\\\",\\n\\t\\t\\\"description\\\": \\\"Encapsulate selected text in paragraph tags\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"<p style=\\\\\\\"display: inline\\\\\\\">\\\",\\n\\t\\t\\t\\\"$TM_SELECTED_TEXT\\\",\\n\\t\\t\\t\\\"</p>\\\"\\n\\t\\t]\\n\\t}\\n}\\n\",\"markdown.json\":\"{\\n\\t// Place your snippets for markdown here. Each snippet is defined under a snippet name and has a prefix, body and \\n\\t// description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:\\n\\t// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the \\n\\t// same ids are connected.\\n\\t// Example:\\n\\t// \\\"Print to console\\\": {\\n\\t// \\t\\\"prefix\\\": \\\"log\\\",\\n\\t// \\t\\\"body\\\": [\\n\\t// \\t\\t\\\"console.log('$1');\\\",\\n\\t// \\t\\t\\\"$2\\\"\\n\\t// \\t],\\n\\t// \\t\\\"description\\\": \\\"Log output to console\\\"\\n\\t// }\\n\\t\\\"az-tosp\\\":{\\n\\t\\t\\\"description\\\": \\\"Insert Azure Devops Table of Subpages markdown\\\",\\n\\t\\t\\\"prefix\\\": \\\"az-tosp\\\",\\n\\t\\t\\\"body\\\": \\\"[[_TOSP_]]\\\"\\n\\t},\\n\\t\\\"az-toc\\\":{\\n\\t\\t\\\"description\\\": \\\"Insert Azure Devops Table of Contents markdown\\\",\\n\\t\\t\\\"prefix\\\": \\\"az-toc\\\",\\n\\t\\t\\\"body\\\": \\\"[[_TOC_]]\\\"\\n\\t},\\n\\t\\\"az-urllink\\\": {\\n\\t\\t\\\"prefix\\\": \\\"az-urllink\\\",\\n\\t\\t\\\"description\\\": \\\"Add Azure Devops url link syntax\\\",\\n\\t\\t\\\"body\\\": \\\"[text](url)\\\"\\n\\t},\\n\\t\\\"table_head\\\":{\\n\\t\\t\\\"description\\\": \\\"Inserts a dummy markdown table\\\",\\n\\t\\t\\\"prefix\\\": \\\"tbl_hdr\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"| Col1 | Col2 | Col3 |\\\",\\n\\t\\t\\t\\\"| ---- | ---- | ---- |\\\"\\n\\t\\t]\\n\\t},\\n\\t\\\"tf-docs-begin-end\\\":{\\n\\t\\t\\\"description\\\": \\\"Inserts begin/end tags to insert terraform-docs output\\\",\\n\\t\\t\\\"prefix\\\": \\\"tf-docs-begin-end\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"<!-- BEGIN_TF_DOCS -->\\\",\\n\\t\\t\\t\\\"<!-- END_TF_DOCS -->\\\"\\n\\t\\t]\\n\\t},\\n\\t\\\"mdlint-x-nextline\\\": {\\n\\t\\t\\\"description\\\": \\\"Disables a rule for the next line\\\",\\n\\t\\t\\\"prefix\\\": \\\"mdlint-x-nextline\\\",\\n\\t\\t\\\"body\\\": \\\"<!-- markdownlint-disable-next-line -->\\\"\\n\\t},\\n\\t\\\"mdcode-pwsh\\\":{\\n\\t\\t\\\"description\\\": \\\"Code block for PowerShell\\\",\\n\\t\\t\\\"prefix\\\": \\\"md-code-pwsh\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"~~~:PowerShell\\\",\\n\\t\\t\\t\\\"$TM_SELECTED_TEXT\\\",\\n\\t\\t\\t\\\"~~~\\\"\\n\\t\\t]\\n\\t}\\n}\",\"powershell.json\":\"{\\n    \\\"_credFromString\\\": {\\n        \\\"prefix\\\": \\\"_cred-from-string\\\",\\n        \\\"body\\\": [\\n            \\\"# ${1:Name} credentials\\\",\\n            \\\"\\\\\\\\$username = '${2:Username}'\\\",\\n            \\\"\\\\\\\\$password = '${3:Password}' | ConvertTo-SecureString -AsPlainText -Force\\\",\\n            \\\"\\\\\\\\$credential = [PSCredential]::New(\\\\\\\\$username,\\\\\\\\$password)\\\\r\\\\r$0\\\"\\n        ],\\n        \\\"description\\\": \\\"Create credentials object from string within script (insecure)\\\"\\n    },\\n    \\\"BuildEnvVars\\\": {\\n        \\\"description\\\": \\\"Create Comment block for Azure Pipeline Env Vars\\\",\\n        \\\"prefix\\\": \\\"_buildVars\\\",\\n        \\\"body\\\": [\\n            \\\"<# #----------------------------------------------------------\\\",\\n            \\\"    \\\\\\\\$env:VNEXT_REGION = 'uk'\\\",\\n            \\\"    \\\\\\\\$env:VNEXT_DEPLOY_SLOT = 'stg'\\\",\\n            \\\"    \\\\\\\\$env:BUILD_SOURCESDIRECTORY = (Join-Path \\\\\\\\$PSScriptRoot '..\\\\\\\\..' -Resolve)\\\",\\n            \\\"    \\\\\\\\$env:BUILD_ARTIFACTSTAGINGDIRECTORY = (Join-Path \\\\\\\\$PSScriptRoot '..\\\\\\\\..\\\\\\\\.temp\\\\\\\\TestAzData' -Resolve)\\\",\\n            \\\"    \\\\\\\\$env:AZDO_SERVICE_CONNECTIONS_FILEPATH = (Get-ChildItem (Join-Path \\\\\\\\$PSScriptRoot '..\\\\\\\\..' -Resolve) -Filter 'AzDoServiceConnections.json' -Recurse | Select-Object -First 1).FullName\\\",\\n            \\\"    \\\\\\\\$env:AZDO_SERVICE_CONNECTION_NAME = 'Aprobrium UAE (8ec00540-f27f-40ec-b524-8af67f229790)'\\\",\\n            \\\"    \\\\\\\\$env:AZDO_SERVICE_CONNECTION_NAME = 'VNext'\\\",\\n            \\\"   #----------------------------------------------------------#>\\\"\\n        ]\\n    },\\n    \\\"_ImportInModule\\\": {\\n        \\\"body\\\": \\\"Import-Module (Get-ChildItem (Join-Path $$PSScriptRoot '..\\\\\\\\module' -Resolve) -Filter '*.psd1' -Recurse -Depth 1 | Select-Object -First 1).FullName\\\",\\n        \\\"description\\\": \\\"Searches parent folder and for 1st psd1 in sub folder modules\\\",\\n        \\\"prefix\\\": \\\"_ImportInModule\\\"\\n    },\\n    \\\"_ImportInModule_Pester\\\": {\\n        \\\"body\\\": \\\"Import-Module (Get-ChildItem (Join-Path $$PSScriptRoot '..' -Resolve) -Filter '*.psd1' | Select-Object -First 1).FullName\\\",\\n        \\\"description\\\": \\\"Searches parent folder and for 1st psd1 in sub folder modules\\\",\\n        \\\"prefix\\\": \\\"_ImportInModulePester\\\"\\n    },\\n    \\\"_PTestModuleBeforeAll\\\": {\\n        \\\"body\\\": [],\\n        \\\"description\\\": \\\"Ensures correct setup testing in a module\\\",\\n        \\\"prefix\\\": \\\"_PTestModuleBeforeAll\\\"\\n    },\\n    \\\"_PTestBasicDescribe\\\": {\\n        \\\"body\\\": [\\n            \\\"Describe -Tag 'Unit' 'Description of tests' -Skip:$$false {\\\",\\n            \\\"    Context -Tag 'Unit' 'Description of context' -Skip:$$false {\\\",\\n            \\\"        It -Tag 'Unit' 'Default inconclusive test' -Skip:$$false {\\\",\\n            \\\"            Set-ItResult -Inconclusive -Because 'Need to define tests for this'\\\",\\n            \\\"            <# TODO: Get-LocalCredential.tests.ps1\\\",\\n            \\\"                Need to define tests for this\\\",\\n            \\\"            #>\\\",\\n            \\\"        }\\\",\\n            \\\"    }\\\",\\n            \\\"}\\\"\\n        ],\\n        \\\"description\\\": \\\"Inserts a Describe / Context / It block\\\",\\n        \\\"prefix\\\": \\\"_PTestBasicDescribe\\\"\\n    },\\n    \\\"_PTestMsg\\\": {\\n        \\\"body\\\": \\\"Write-Host ('[$TM_FILENAME_BASE] {0} Message' -f $$____Pester.CurrentTest.Name) -BackgroundColor Green -ForegroundColor Black\\\",\\n        \\\"description\\\": \\\"Output a message in Pester, separate color\\\",\\n        \\\"prefix\\\": \\\"_PTestMsg\\\"\\n    },\\n    \\\"Class-Setup\\\": {\\n        \\\"description\\\": \\\"Templated Class structure\\\",\\n        \\\"prefix\\\": \\\"Class-Init\\\",\\n        \\\"body\\\": [\\n            \\\"class $TM_FILENAME_BASE {\\\",\\n            \\\"    $TM_FILENAME_BASE(<#OptionalParameters#>) {\\\",\\n            \\\"        <# Initialize the class. Use $this to reference the properties of the instance you are creating #>\\\",\\n            \\\"    }\\\",\\n            \\\"}\\\"\\n        ]\\n    },\\n    \\\"Class-Method-StackAdd\\\": {\\n        \\\"description\\\": \\\"Add a base class use of MethodStackAdd\\\",\\n        \\\"prefix\\\": \\\"_clsStackAddMethodName\\\",\\n        \\\"body\\\": \\\"\\\\\\\\$this.MethodStackAdd('${0:Name}')\\\"\\n    },\\n    \\\"Class-Method-StackRemove\\\": {\\n        \\\"description\\\": \\\"Add a base class use of MethodStackAdd\\\",\\n        \\\"prefix\\\": \\\"_clsStackRemMethodName\\\",\\n        \\\"body\\\": \\\"\\\\\\\\$this.MethodStackRemove()\\\"\\n    },\\n    \\\"Class-Method-Stacked\\\": {\\n        \\\"body\\\": [\\n            \\\"[void] ${0:methodname}(<#Params#>) {\\\",\\n            \\\"    \\\\\\\\$this.MethodStackAdd('${0}')\\\",\\n            \\\"    \\\\\\\\$this.MethodStackRemove()\\\",\\n            \\\"}\\\"\\n        ],\\n        \\\"description\\\": \\\"Templated hidden method in class\\\",\\n        \\\"prefix\\\": \\\"_clsStackedClassMethod\\\"\\n    },\\n    \\\"Class-Method-Hidden\\\": {\\n        \\\"body\\\": [\\n            \\\"hidden [void] ${1:methodname}(<#Params#>) {\\\",\\n            \\\"}\\\"\\n        ],\\n        \\\"description\\\": \\\"Templated hidden method in class\\\",\\n        \\\"prefix\\\": \\\"Class-Method-Hidden\\\"\\n    },\\n    \\\"Class-Property-Hidden\\\": {\\n        \\\"body\\\": [\\n            \\\"hidden [${1:type}] $$_${0:propertyname}\\\"\\n        ],\\n        \\\"description\\\": \\\"Templated hidden property in class\\\",\\n        \\\"prefix\\\": \\\"Class-Property-Hidden\\\"\\n    },\\n    \\\"Class-WriteToLog-IndentDecrement\\\": {\\n        \\\"body\\\": [\\n            \\\"$$this.LogIndentDecrement()\\\"\\n        ],\\n        \\\"description\\\": \\\"Templated class WriteToLog Decrease Indent\\\",\\n        \\\"prefix\\\": \\\"Class-WriteToLog-IndentDecrement\\\"\\n    },\\n    \\\"Class-WriteToLog-IndentIncrement\\\": {\\n        \\\"body\\\": [\\n            \\\"$$this.LogIndentIncrement()\\\"\\n        ],\\n        \\\"description\\\": \\\"Templated class WriteToLog increase Indent\\\",\\n        \\\"prefix\\\": \\\"Class-WriteToLog-IndentIncrement\\\"\\n    },\\n    \\\"Class-WriteToLog-Info\\\": {\\n        \\\"body\\\": [\\n            \\\"$$this.WriteToLog('INIT', 'Message', @(), [WriteToLogLevel]::INFO)\\\"\\n        ],\\n        \\\"description\\\": \\\"Templated class WriteToLog Message\\\",\\n        \\\"prefix\\\": \\\"Class-WriteToLog-Info\\\"\\n    },\\n    \\\"Class-WriteToLog-Warning\\\": {\\n        \\\"body\\\": [\\n            \\\"$$this.WriteToLog('INIT', 'Message', @(), [WriteToLogLevel]::WARNING)\\\"\\n        ],\\n        \\\"description\\\": \\\"Templated class WriteToLog Message for Warnings\\\",\\n        \\\"prefix\\\": \\\"Class-WriteToLog-Warning\\\"\\n    },\\n    \\\"CLogging End\\\": {\\n        \\\"body\\\": [\\n            \\\"    Write-CustomLog -Level INFO -Message '{0}ENDED{0}' -Arguments @('----------')\\\",\\n            \\\"if (!$$Quiet) {\\\",\\n            \\\"}\\\"\\n        ],\\n        \\\"description\\\": \\\"Write-CustomLog INFO End of Process\\\",\\n        \\\"prefix\\\": \\\"_CLogEnd\\\"\\n    },\\n    \\\"CLogging Error\\\": {\\n        \\\"body\\\": \\\"Write-CustomLog -Level ERROR -Message '$1' -Arguments @() -ThrowOnError\\\",\\n        \\\"description\\\": \\\"Write-CustomLog ERROR\\\",\\n        \\\"prefix\\\": \\\"_CLogError\\\"\\n    },\\n    \\\"CLogging Info\\\": {\\n        \\\"body\\\": [\\n            \\\"Write-CustomLog -Level INFO -Message '$1' -Arguments @()\\\"\\n        ],\\n        \\\"description\\\": \\\"Write-CustomLog INFO\\\",\\n        \\\"prefix\\\": \\\"_CLogInfo\\\"\\n    },\\n    \\\"CLogging Info Quiet\\\": {\\n        \\\"body\\\": [\\n            \\\"    Write-CustomLog -Level INFO -Message '$1' -Arguments @()\\\",\\n            \\\"if (!$$Quiet) {\\\",\\n            \\\"}\\\"\\n        ],\\n        \\\"description\\\": \\\"Write-CustomLog INFO, test for Quiet flag\\\",\\n        \\\"prefix\\\": \\\"_CLogInfo-Quiet\\\"\\n    },\\n    \\\"CLogging Start\\\": {\\n        \\\"body\\\": [\\n            \\\"    Write-CustomLog -Level INFO -Message '{0}STARTED{0}' -Arguments @('----------')\\\",\\n            \\\"if (!$$Quiet) {\\\",\\n            \\\"}\\\"\\n        ],\\n        \\\"description\\\": \\\"Write-CustomLog INFO Start of Process\\\",\\n        \\\"prefix\\\": \\\"_CLogStart\\\"\\n    },\\n    \\\"CLogging ThrowError\\\": {\\n        \\\"body\\\": \\\"Write-CustomLog -Level ERROR -Message '$1' -ThrowError\\\",\\n        \\\"description\\\": \\\"Write-CustomLog ERROR\\\",\\n        \\\"prefix\\\": \\\"_CLogThrowError\\\"\\n    },\\n    \\\"CLogging Warning\\\": {\\n        \\\"body\\\": \\\"Write-CustomLog -Level WARNING -Message '$1' -Arguments @()\\\",\\n        \\\"description\\\": \\\"Write-CustomLog WARNING\\\",\\n        \\\"prefix\\\": \\\"_CLogWarning\\\"\\n    },\\n    \\\"FileNameAsComment\\\": {\\n        \\\"description\\\": \\\"Adds the script file name as a comment line\\\",\\n        \\\"prefix\\\": \\\"filename_comment\\\",\\n        \\\"body\\\": \\\"# File: ${TM_DIRECTORY}/$TM_FILENAME\\\"\\n    },\\n    \\\"GitRepoRootPathFunction\\\": {\\n        \\\"prefix\\\": \\\"GitRepoRootPathFunction\\\",\\n        \\\"description\\\": \\\"Add function to find the git repository root path from script path\\\",\\n        \\\"body\\\": [\\n            \\\"function Get-GitRootPath {\\\",\\n            \\\"[CmdletBinding()]\\\",\\n            \\\"param (\\\",\\n            \\\"    [Parameter(Mandatory)]\\\",\\n            \\\"    [ValidateScript({ (Test-Path $$_ -PathType Container) })]\\\",\\n            \\\"    [string]$$Path\\\",\\n            \\\")\\\",\\n            \\\"# Find the repository route path\\\",\\n            \\\"$$counter = 1\\\",\\n            \\\"$$gitfolder = Get-ChildItem $$Path -Dir -Force -Filter '.git'\\\",\\n            \\\"while (($$null -eq $$gitfolder) -and ($$counter -lt 5)) {\\\",\\n            \\\"    $$Path = (Join-Path $$Path '..' -Resolve)\\\",\\n            \\\"    $$gitfolder = Get-ChildItem $$Path -Dir -Force -Filter '.git'\\\",\\n            \\\"    $$counter++\\\",\\n            \\\"}\\\",\\n            \\\"if ($$null -eq $$gitfolder) {\\\",\\n            \\\"    return $$null\\\",\\n            \\\"}\\\",\\n            \\\"return $$Path\\\",\\n            \\\"}\\\",\\n        ]\\n    },\\n    \\\"ModuleFunction\\\": {\\n        \\\"body\\\": [\\n            \\\"function $TM_FILENAME_BASE {\\\",\\n            \\\"    [CmdletBinding()]\\\",\\n            \\\"    param ()\\\",\\n            \\\"    begin {\\\",\\n            \\\"        Write-Verbose ('[{0}|{1}] --STARTED: message-text' -f (Get-Date -Format 'yyyy-MMM-dd HH:mm:ss'), (Get-PSCallStack)[0].FunctionName)\\\",\\n            \\\"    }\\\",\\n            \\\"    process {}\\\",\\n            \\\"    end {\\\",\\n            \\\"        Write-Verbose ('[{0}|{1}] --ENDED: message-text' -f (Get-Date -Format 'yyyy-MMM-dd HH:mm:ss'), (Get-PSCallStack)[0].FunctionName)\\\",\\n            \\\"    }\\\",\\n            \\\"}\\\"\\n        ],\\n        \\\"description\\\": \\\"Inserts a module function template\\\",\\n        \\\"prefix\\\": \\\"_ModuleFunction\\\"\\n    },\\n    \\\"ParamValidDir\\\": {\\n        \\\"body\\\": \\\"[ValidateScript({ (Test-Path $$_ -PathType Container) })]\\\",\\n        \\\"description\\\": \\\"Parameter attribute to validate directory path\\\",\\n        \\\"prefix\\\": \\\"ParamValidDir\\\"\\n    },\\n    \\\"ParamValidFile\\\": {\\n        \\\"body\\\": \\\"[ValidateScript({ (Test-Path $$_ -PathType Leaf) })]\\\",\\n        \\\"description\\\": \\\"Parameter attribute to validate directory path\\\",\\n        \\\"prefix\\\": \\\"ParamValidFile\\\"\\n    },\\n    \\\"ParamValidXLCol\\\": {\\n        \\\"body\\\": \\\"[ValidateScript({ (($$_ -gt 0) -and ($_ -lt 257) })]\\\",\\n        \\\"description\\\": \\\"Parameter attribute to validate Excel Column number\\\",\\n        \\\"prefix\\\": \\\"ParamValidXLCol\\\"\\n    },\\n    \\\"ParamValidXLRol\\\": {\\n        \\\"body\\\": \\\"[ValidateScript({ (($$_ -gt 0) -and ($_ -lt 1048576)) })]\\\",\\n        \\\"description\\\": \\\"Parameter attribute to validate Excel Row number\\\",\\n        \\\"prefix\\\": \\\"ParamValidXLRol\\\"\\n    },\\n    \\\"EmbeddedStartUpFunction\\\": {\\n        \\\"description\\\": \\\"Templated function for use in Pester Friendly Scripts\\\",\\n        \\\"prefix\\\": \\\"embeddedStartUpFunc\\\",\\n        \\\"body\\\": [\\n            \\\"# File: ${TM_DIRECTORY}/$TM_FILENAME\\\",\\n            \\\"[CmdletBinding()]\\\",\\n            \\\"param (\\\",\\n            \\\"    [string]\\\\\\\\$ModuleName = 'DevopsUtils',\\\",\\n            \\\"    [bool]\\\\\\\\$RunningInBuild = (![string]::IsNullOrEmpty(\\\\\\\\$env:TF_BUILD))\\\",\\n            \\\"   # TODO: Add any other top level parameters\\\",\\n            \\\")\\\",\\n            \\\"\\\",\\n            \\\"\\\\\\\\$ErrorActionPreference = 'stop'\\\",\\n            \\\"\\\",\\n            \\\" # TODO: Add / move to module cmdlet\\\",\\n            \\\"function ${TM_FILENAME_BASE} {\\\",\\n            \\\"    [CmdletBinding()]\\\",\\n            \\\"    param (\\\",\\n            \\\"        [Parameter(Mandatory = \\\\\\\\$true,\\\",\\n            \\\"            Position = 0,\\\",\\n            \\\"            ValueFromPipeline = \\\\\\\\$true,\\\",\\n            \\\"            ValueFromPipelineByPropertyName = \\\\\\\\$true,\\\",\\n            \\\"            HelpMessage = 'Calling script root path')]\\\",\\n            \\\"        [Alias('PSScriptRoot')]\\\",\\n            \\\"        [ValidateScript({ (Test-Path \\\\\\\\$_ -PathType Container) })]\\\",\\n            \\\"        [string]\\\\\\\\$ScriptRootPath,\\\",\\n            \\\"        [Parameter(Mandatory = \\\\\\\\$true,\\\",\\n            \\\"            Position = 1,\\\",\\n            \\\"            ValueFromPipeline = \\\\\\\\$true,\\\",\\n            \\\"            ValueFromPipelineByPropertyName = \\\\\\\\$true,\\\",\\n            \\\"            HelpMessage = 'Path the json Terraform State file.')]\\\",\\n            \\\"        [Alias('FilePath')]\\\",\\n            \\\"        [ValidateNotNullOrEmpty()]\\\",\\n            \\\"        [string]\\\\\\\\$Path\\\",\\n            \\\"    )\\\",\\n            \\\"}\\\",\\n            \\\"\\\",\\n            \\\"Write-Host ('[{0}|{1}] Import Devops Module' -f (Get-Date -Format 'yyyy-MMM-dd HH:mm:ss'), (Split-Path -Leaf \\\\\\\\$PSCommandPath))\\\",\\n            \\\"Import-Module (Get-ChildItem (Join-Path \\\\\\\\$PSScriptRoot '..\\\\\\\\module' -Resolve) -Filter ('{0}.psd1' -f \\\\\\\\$ModuleName) -Recurse -Depth 1 | Select-Object -First 1).FullName\\\",\\n            \\\"\\\",\\n            \\\"\\\\\\\\$localSettings = (New-LocalExecSettingsClass -ScriptName (Split-Path -Leaf \\\\\\\\$PSCommandPath).Replace('.ps1', '') -ScriptPath \\\\\\\\$PSScriptRoot)\\\",\\n            \\\"\\\",\\n            \\\"# To make this pester testable let us inspect the Call Stack\\\",\\n            \\\"if (\\\\\\\\$null -ne (Get-PSCallStack | Where-Object { \\\\\\\\$_.FunctionName.ToLower().Contains('pester') })) {\\\",\\n            \\\"    Write-Host ('{0} called from Pester Test' -f (Split-Path -Leaf \\\\\\\\$PSCommandPath)) -ForegroundColor Green\\\",\\n            \\\"} else {\\\",\\n            \\\"    # ----------------------------------------------------------------------------------\\\",\\n            \\\"    # Match script parameters to cmdlet parameters\\\",\\n            \\\"    # ----------------------------------------------------------------------------------\\\",\\n            \\\"    \\\\\\\\$callParams = \\\\\\\\$localSettings.CallParamTable('${TM_FILENAME_BASE}', \\\\\\\\$ModuleName, \\\\\\\\$PSCmdlet.MyInvocation.MyCommand.Parameters)\\\",\\n            \\\"    if (!\\\\\\\\$localSettings.IsBuild()) {\\\",\\n            \\\"        Write-Warning ('[{0}|{1}] Running locally' -f (Get-Date -Format 'yyyy-MMM-dd HH:mm:ss'), \\\\\\\\$localSettings.ScriptName)\\\",\\n            \\\"        \\\\\\\\$localSettings.SetFunctionCallParams()\\\",\\n            \\\"        \\\\\\\\$localSettings.AzLogin()   # ----Use this if locally logging into Azure with your credentials\\\",\\n            \\\"    }\\\",\\n            \\\"    ${TM_FILENAME_BASE} @callParams\\\",\\n            \\\"}\\\",\\n        ]\\n    },\\n    \\\"PSDocs_ClassDesc\\\": {\\n        \\\"body\\\": [\\n            \\\"   $TM_FILENAME_BASE $1\\\",\\n            \\\"#>\\\",\\n            \\\"<# PSDOCS: Description\\\"\\n        ],\\n        \\\"description\\\": \\\"PSDocs Helper Class description comment for docs\\\",\\n        \\\"prefix\\\": \\\"_psdocs_class_description\\\"\\n    },\\n    \\\"PSDocs_DocHelperSection\\\": {\\n        \\\"body\\\": [\\n            \\\"    $$TargetObject.WriteSectionLog($1, 'ENDED')\\\",\\n            \\\"    $$TargetObject.WriteSectionLog($1, 'STARTED')\\\",\\n            \\\"    ('Details for go here')\\\",\\n            \\\"$$${1:sectionVarName} = $$TargetObject.AddIndexedSectionInfo('${2:SectionTitle}', 2)\\\",\\n            \\\"Section -Name $$TargetObject.GetSectionInfo($1).Title -Force {\\\",\\n            \\\"}\\\"\\n        ],\\n        \\\"description\\\": \\\"PSDocs Helper default section\\\",\\n        \\\"prefix\\\": \\\"_psdocs_helper_section\\\"\\n    },\\n    \\\"PSDocs_DocHelperStart\\\": {\\n        \\\"body\\\": [\\n            \\\"\\\",\\n            \\\"   $$mdHelp = $$TargetObject.MarkdownHelper()\\\",\\n            \\\"   $$mdHelp.AddSectionInfo('$1','$1',2)\\\",\\n            \\\"   $$TargetObject.WriteToLog($$InstanceName, 'End creating document')\\\",\\n            \\\"   $$TargetObject.WriteToLog($$InstanceName, 'Start creating document')\\\",\\n            \\\"   '[[_TOSP_]]'\\\",\\n            \\\"Document '$TM_FILENAME_BASE' {\\\",\\n            \\\"}\\\"\\n        ],\\n        \\\"description\\\": \\\"PSDocs Helper object message start of document\\\",\\n        \\\"prefix\\\": \\\"_psdocs_helper_start\\\"\\n    },\\n    \\\"PSDocs_DocSection\\\": {\\n        \\\"body\\\": [\\n            \\\"    $$TargetObject.WriteSectionLog($1, 'ENDED')\\\",\\n            \\\"    $$TargetObject.WriteSectionLog($1, 'STARTED')\\\",\\n            \\\"    <# Section Code goes here #>\\\",\\n            \\\"$$${1:sectKey} = $$TargetObject.AddIndexedSectionInfo('${0:SectionTitle}', 2)\\\",\\n            \\\"Section -Name $$TargetObject.GetSectionInfo($1).Title -Force {\\\",\\n            \\\"}\\\"\\n        ],\\n        \\\"description\\\": \\\"PSDocs Helper log message start of section\\\",\\n        \\\"prefix\\\": \\\"_psdocs_section_start\\\"\\n    },\\n    \\\"PSDocs_DocStart\\\": {\\n        \\\"body\\\": [\\n            \\\"Document '$TM_FILENAME_BASE' {\\\",\\n            \\\"}\\\"\\n        ],\\n        \\\"description\\\": \\\"PSDocs Helper log message start of document\\\",\\n        \\\"prefix\\\": \\\"_psdocs_start\\\"\\n    },\\n    \\\"PSDocs_LogEnd\\\": {\\n        \\\"body\\\": \\\"$$TargetObject.WriteToLog('ENDED', $$Document)\\\",\\n        \\\"description\\\": \\\"PSDocs Helper log message end of document\\\",\\n        \\\"prefix\\\": \\\"_psdocs_logend\\\"\\n    },\\n    \\\"Queue-Create\\\": {\\n        \\\"body\\\": \\\"$$q = New-Object System.Collections.Queue\\\",\\n        \\\"description\\\": \\\"Instantiate LIFO Queue\\\",\\n        \\\"prefix\\\": \\\"_Queue-Create\\\"\\n    },\\n    \\\"Quiet-If\\\": {\\n        \\\"body\\\": [\\n            \\\" \\\",\\n            \\\"$TM_SELECTED_TEXT\\\",\\n            \\\"if (!$$Quiet) {\\\",\\n            \\\"}\\\"\\n        ],\\n        \\\"description\\\": \\\"Wraps an if quiet flag around commands\\\",\\n        \\\"prefix\\\": \\\"_Quiet-If\\\"\\n    },\\n    \\\"Quiet-If-Class\\\": {\\n        \\\"body\\\": [\\n            \\\" \\\",\\n            \\\"$TM_SELECTED_TEXT\\\",\\n            \\\"if (!$$this.Quiet) {\\\",\\n            \\\"}\\\"\\n        ],\\n        \\\"description\\\": \\\"Wraps an if quiet flag around commands\\\",\\n        \\\"prefix\\\": \\\"_Quiet-If-Class\\\"\\n    },\\n    \\\"Quiet-Param\\\": {\\n        \\\"body\\\": [\\n            \\\",\\\",\\n            \\\"[switch]$$Quiet\\\"\\n        ],\\n        \\\"description\\\": \\\"Inserts a Quiet parameter\\\",\\n        \\\"prefix\\\": \\\"_Quiet-Param\\\"\\n    },\\n    \\\"Quiet-Param-PassOn\\\": {\\n        \\\"body\\\": \\\" -Quiet:$$Quiet\\\",\\n        \\\"description\\\": \\\"Sets Quiet parameter for subsequent calls\\\",\\n        \\\"prefix\\\": \\\"_Quiet-Param-PassOn\\\"\\n    },\\n    \\\"Quiet-Prop-Class\\\": {\\n        \\\"body\\\": [\\n            \\\"    [bool]$$Quiet = $$true\\\"\\n        ],\\n        \\\"description\\\": \\\"Inserts a Quiet property\\\",\\n        \\\"prefix\\\": \\\"_Quiet-Prop-Class\\\"\\n    },\\n    \\\"Region around Code\\\": {\\n        \\\"body\\\": [\\n            \\\"#region $1\\\",\\n            \\\"$TM_SELECTED_TEXT\\\",\\n            \\\"#endregion $1\\\",\\n        ],\\n        \\\"description\\\": \\\"Defines a region around a currently selected block\\\",\\n        \\\"prefix\\\": \\\"Region Block\\\"\\n    },\\n    \\\"TODO Comment Block\\\": {\\n        \\\"body\\\": [\\n            \\\"<# TODO: $1 ($CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE @$CURRENT_HOUR:$CURRENT_MINUTE:$CURRENT_SECOND)\\\",\\n            \\\"    $TM_SELECTED_TEXT\\\",\\n            \\\"#>\\\"\\n        ],\\n        \\\"description\\\": \\\"Encapsulates the current highlighted or inserts a TODO: Comment\\\",\\n        \\\"prefix\\\": \\\"TODO Comments\\\"\\n    },\\n    \\\"VerboseLog If Block (class)\\\": {\\n        \\\"body\\\": [\\n            \\\"\\\",\\n            \\\"$TM_SELECTED_TEXT\\\",\\n            \\\"if ($$this.VerboseLog) {\\\",\\n            \\\"}\\\"\\n        ],\\n        \\\"description\\\": \\\"Encapsulates the current highlighted text in a if / endif testing $VerboseLog flag\\\",\\n        \\\"prefix\\\": \\\"VerboseLog in Class\\\"\\n    },\\n    \\\"Transcript File Start / End to file\\\": {\\n        \\\"description\\\": \\\"Starts / ends Transcript to file \\\",\\n        \\\"prefix\\\": \\\"tscriptToFile\\\",\\n        \\\"body\\\": [\\n            \\\"$$tmpAuditFile = New-TemporaryFile\\\",\\n            \\\"Start-Transcript -Path $$tmpAuditFile\\\",\\n            \\\"${TM_SELECTED_TEXT}\\\",\\n            \\\"Stop-Transcript\\\",\\n            \\\"$$auditFile = (Join-Path ($$PSCommandPath -replace '\\\\\\\\.ps1', '') ('{0}_Audit_{1}.log' -f $$env:COMPUTERNAME, (Get-Date -Format 'yyyy-MM-dd_hhmmss')))\\\",\\n            \\\"Remove-Item $$auditFile -Force -ErrorAction SilentlyContinue\\\",\\n            \\\"Get-Content $$tmpAuditFile | ForEach-Object {\\\",\\n            \\\"    if (![string]::IsNullOrEmpty($$_.Trim())) {\\\",\\n            \\\"        Add-Content $$auditFile -Value $$_\\\",\\n            \\\"    }\\\",\\n            \\\"}\\\",\\n            \\\"Remove-Item $$tmpAuditFile -Force -ErrorAction SilentlyContinue\\\"\\n        ]\\n    },\\n    \\\"Transcript Log Start Message\\\": {\\n        \\\"description\\\": \\\"Outputs a start message for transcript log\\\",\\n        \\\"prefix\\\": \\\"ts_LogStart\\\",\\n        \\\"body\\\": \\\"Write-Host ('[{0}|{1}] --STARTED: ${1:message-text}' -f (Get-Date -Format 'yyyy-MMM-dd HH:mm:ss'), (Get-PSCallStack)[0].FunctionName)\\\"\\n    },\\n    \\\"Transcript Log End Message\\\": {\\n        \\\"description\\\": \\\"Outputs a End message for transcript log\\\",\\n        \\\"prefix\\\": \\\"ts_LogEnd\\\",\\n        \\\"body\\\": \\\"Write-Host ('[{0}|{1}] ----ENDED: ${1:message-text}' -f (Get-Date -Format 'yyyy-MMM-dd HH:mm:ss'), (Get-PSCallStack)[0].FunctionName)\\\"\\n    },\\n    \\\"Transcript Log SepMessage\\\": {\\n        \\\"description\\\": \\\"Outputs a message for transcript log\\\",\\n        \\\"prefix\\\": \\\"ts_LogSep\\\",\\n        \\\"body\\\": \\\"Write-Host ('[{0}|{1}] {2}' -f (Get-Date -Format 'yyyy-MMM-dd HH:mm:ss'), (Get-PSCallStack)[0].FunctionName, ('-'*25))\\\"\\n    },\\n    \\\"Transcript Log Message\\\": {\\n        \\\"description\\\": \\\"Outputs a message for transcript log\\\",\\n        \\\"prefix\\\": \\\"ts_LogMsg\\\",\\n        \\\"body\\\": \\\"Write-Host ('[{0}|{1}] ${1:message-text}' -f (Get-Date -Format 'yyyy-MMM-dd HH:mm:ss'), (Get-PSCallStack)[0].FunctionName)\\\"\\n    },\\n    \\\"Transcript Log Start Message (Pester)\\\": {\\n        \\\"description\\\": \\\"Outputs a start message for transcript log\\\",\\n        \\\"prefix\\\": \\\"ts_pLogStart\\\",\\n        \\\"body\\\": \\\"Write-Host ('[{0}|{1}] --STARTED: ${1:message-text}' -f (Get-Date -Format 'yyyy-MMM-dd HH:mm:ss'), (Get-PSCallStack)[0].FunctionName) -ForegroundColor White -BackgroundColor Blue\\\"\\n    },\\n    \\\"Transcript Log End Message (Pester)\\\": {\\n        \\\"description\\\": \\\"Outputs a End message for transcript log\\\",\\n        \\\"prefix\\\": \\\"ts_pLogEnd\\\",\\n        \\\"body\\\": \\\"Write-Host ('[{0}|{1}] ----ENDED: ${1:message-text}' -f (Get-Date -Format 'yyyy-MMM-dd HH:mm:ss'), (Get-PSCallStack)[0].FunctionName) -ForegroundColor White -BackgroundColor Blue\\\"\\n    },\\n    \\\"Transcript Log Message (Pester)\\\": {\\n        \\\"description\\\": \\\"Outputs a message for transcript log for pester\\\",\\n        \\\"prefix\\\": \\\"ts_pLogMsg\\\",\\n        \\\"body\\\": \\\"Write-Host ('[{0}|{1}] ${1:message-text}' -f (Get-Date -Format 'yyyy-MMM-dd HH:mm:ss'), (Get-PSCallStack)[0].FunctionName) -ForegroundColor White -BackgroundColor Blue\\\"\\n    },\\n    \\\"Transcript Log Start Message (Verbose)\\\": {\\n        \\\"description\\\": \\\"Outputs a VERBOSE start message for transcript log\\\",\\n        \\\"prefix\\\": \\\"ts_vLogStart\\\",\\n        \\\"body\\\": \\\"Write-Verbose ('[{0}|{1}] --STARTED: ${1:message-text}' -f (Get-Date -Format 'yyyy-MMM-dd HH:mm:ss'), (Get-PSCallStack)[0].FunctionName)\\\"\\n    },\\n    \\\"Transcript Log End Message (Verbose)\\\": {\\n        \\\"description\\\": \\\"Outputs a VERBOSE End message for transcript log\\\",\\n        \\\"prefix\\\": \\\"ts_vLogEnd\\\",\\n        \\\"body\\\": \\\"Write-Verbose ('[{0}|{1}] ----ENDED: ${1:message-text}' -f (Get-Date -Format 'yyyy-MMM-dd HH:mm:ss'), (Get-PSCallStack)[0].FunctionName)\\\"\\n    },\\n    \\\"Transcript Log Message (Verbose)\\\": {\\n        \\\"description\\\": \\\"Outputs a VERBOSE message for transcript log for pester\\\",\\n        \\\"prefix\\\": \\\"ts_vLogMsg\\\",\\n        \\\"body\\\": \\\"Write-Verbose ('[{0}|{1}] ${1:message-text}' -f (Get-Date -Format 'yyyy-MMM-dd HH:mm:ss'), (Get-PSCallStack)[0].FunctionName)\\\"\\n    },\\n    \\\"Transcript Log Start Message (Warning)\\\": {\\n        \\\"description\\\": \\\"Outputs a WARNING start message for transcript log\\\",\\n        \\\"prefix\\\": \\\"ts_wLogStart\\\",\\n        \\\"body\\\": \\\"Write-Warning ('[{0}|{1}] --STARTED: ${1:message-text}' -f (Get-Date -Format 'yyyy-MMM-dd HH:mm:ss'), (Get-PSCallStack)[0].FunctionName)\\\"\\n    },\\n    \\\"Transcript Log End Message (Warning)\\\": {\\n        \\\"description\\\": \\\"Outputs a WARNING End message for transcript log\\\",\\n        \\\"prefix\\\": \\\"ts_wLogEnd\\\",\\n        \\\"body\\\": \\\"Write-Warning ('[{0}|{1}] ----ENDED: ${1:message-text}' -f (Get-Date -Format 'yyyy-MMM-dd HH:mm:ss'), (Get-PSCallStack)[0].FunctionName)\\\"\\n    },\\n    \\\"Transcript Log Message (Warning)\\\": {\\n        \\\"description\\\": \\\"Outputs a WARNING message for transcript log for pester\\\",\\n        \\\"prefix\\\": \\\"ts_wLogMsg\\\",\\n        \\\"body\\\": \\\"Write-Warning ('[{0}|{1}] ${1:message-text}' -f (Get-Date -Format 'yyyy-MMM-dd HH:mm:ss'), (Get-PSCallStack)[0].FunctionName)\\\"\\n    },\\n    \\\"ParamList\\\": {\\n        \\\"description\\\": \\\"List local param names and values\\\",\\n        \\\"prefix\\\": \\\"_ParamList\\\",\\n        \\\"body\\\": [\\n            \\\"Write-Host ('[{0}|{1}] {2}' -f (Get-Date -Format 'yyyy-MMM-dd HH:mm:ss'), (Get-PSCallStack)[0].FunctionName, ('-'*25))\\\",\\n            \\\"Write-Host ('[{0}|{1}] ** Passed Parameters **' -f (Get-Date -Format 'yyyy-MMM-dd HH:mm:ss'), (Get-PSCallStack)[0].FunctionName)\\\",\\n            \\\"Write-Host ('[{0}|{1}] {2}' -f (Get-Date -Format 'yyyy-MMM-dd HH:mm:ss'), (Get-PSCallStack)[0].FunctionName, ('-'*25))\\\",\\n            \\\"(\\\\\\\\$PSCmdlet.MyInvocation.MyCommand.Parameters).Keys | ForEach-Object {\\\",\\n            \\\"    if (\\\\\\\\$_ -eq 'Verbose') {\\\",\\n            \\\"        break\\\",\\n            \\\"    }\\\",\\n            \\\"    \\\\\\\\$pValue = (Get-Variable -Name \\\\\\\\$_ -ValueOnly -ErrorAction SilentlyContinue)\\\",\\n            \\\"    if (\\\\\\\\$null -eq \\\\\\\\$pValue) {\\\",\\n            \\\"        \\\\\\\\$pValue = '<null/empty>'\\\",\\n            \\\"    }\\\",\\n            \\\"    Write-Host ('[{0}|{1}] -{2} {3}' -f (Get-Date -Format 'yyyy-MMM-dd HH:mm:ss'), (Split-Path (Get-PSCallStack)[1].ScriptName -Leaf), \\\\\\\\$_, \\\\\\\\$pValue)\\\",\\n            \\\"}\\\",\\n            \\\"Write-Host ('[{0}|{1}] {2}' -f (Get-Date -Format 'yyyy-MMM-dd HH:mm:ss'), (Get-PSCallStack)[0].FunctionName, ('-'*25))\\\"\\n        ]\\n    }\\n}\",\"python.json\":\"{\\n\\t// Place your snippets for python here. Each snippet is defined under a snippet name and has a prefix, body and \\n\\t// description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:\\n\\t// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the \\n\\t// same ids are connected.\\n\\t// Example:\\n\\t// \\\"Print to console\\\": {\\n\\t// \\t\\\"prefix\\\": \\\"log\\\",\\n\\t// \\t\\\"body\\\": [\\n\\t// \\t\\t\\\"console.log('$1');\\\",\\n\\t// \\t\\t\\\"$2\\\"\\n\\t// \\t],\\n\\t// \\t\\\"description\\\": \\\"Log output to console\\\"\\n\\t// }\\n\\t\\\"argParser\\\":{\\n\\t\\t\\\"description\\\": \\\"Implement argument parser for function\\\",\\n\\t\\t\\\"prefix\\\": \\\"_argParser\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"import argparse\\\",\\n\\t\\t\\t\\\"parser = argparse.ArgumentParser(description=\\\\\\\"$TM_FILENAME_BASE\\\\\\\", formatter_class=argparse.ArgumentDefaultsHelpFormatter)\\\",\\n\\t\\t\\t\\\"parser.add_argument(\\\\\\\"--ArgLongName\\\\\\\", \\\\\\\"-asn\\\\\\\", choices=['type1','type2'], help=\\\\\\\"description of arg\\\\\\\", required=True)\\\",\\n\\t\\t\\t\\\"args = parser.parse_args()\\\",\\n\\t\\t\\t\\\"config = vars(args)\\\",\\n\\t\\t\\t\\\"print(config)\\\"\\n\\t\\t]\\n\\t},\\n\\t\\\"docstring_function\\\": {\\n\\t\\t\\\"prefix\\\": \\\"docs_func\\\",\\n\\t\\t\\\"description\\\": \\\"Inserts a stylized docstring into a function\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"    \\\\\\\"\\\\\\\"\\\\\\\"function synapses.\\\",\\n\\t\\t\\t\\\"    \\\",\\n\\t\\t\\t\\\"    description\\\",\\n\\t\\t\\t\\\"    \\\",\\n\\t\\t\\t\\\"    Args:\\\",\\n\\t\\t\\t\\\"        --None--\\\",\\n\\t\\t\\t\\\"    \\\",\\n\\t\\t\\t\\\"    Returns:\\\",\\n\\t\\t\\t\\\"        --None--\\\",\\n\\t\\t\\t\\\"    \\\",\\n\\t\\t\\t\\\"    Raises:\\\",\\n\\t\\t\\t\\\"        --None--\\\",\\n\\t\\t\\t\\\"    \\\",\\n\\t\\t\\t\\\"    \\\\\\\"\\\\\\\"\\\\\\\"\\\",\\n\\t\\t\\t\\\"\\\"\\n\\t\\t]\\n\\t},\\n\\t\\\"docstring_file\\\": {\\n\\t\\t\\\"prefix\\\": \\\"docs_file\\\",\\n\\t\\t\\\"description\\\": \\\"Inserts a stylized docstring into a py file\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"\\\\\\\"\\\\\\\"\\\\\\\"A one line summary of the module or program, terminated by a period.\\\",\\n\\t\\t\\t\\\"\\\",\\n\\t\\t\\t\\\"Leave one blank line.  The rest of this docstring should contain an\\\",\\n\\t\\t\\t\\\"overall description of the module or program.  Optionally, it may also\\\",\\n\\t\\t\\t\\\"contain a brief description of exported classes and functions and/or usage\\\",\\n\\t\\t\\t\\\"examples.\\\",\\n\\t\\t\\t\\\"\\\",\\n\\t\\t\\t\\\"    Typical usage example:\\\",\\n\\t\\t\\t\\\"\\\",\\n\\t\\t\\t\\\"        foo = ClassFoo()\\\",\\n\\t\\t\\t\\\"        bar = foo.FunctionBar()\\\",\\n\\t\\t\\t\\\"    --None--\\\",\\n\\t\\t\\t\\\"\\\\\\\"\\\\\\\"\\\\\\\"\\\",\\n\\t\\t\\t\\\"\\\"\\n\\t\\t]\\n\\t},\\n\\t\\\"def_function\\\": {\\n\\t\\t\\\"prefix\\\": \\\"def_func\\\",\\n\\t\\t\\\"description\\\": \\\"Inserts a stylised docstring into a function\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"\\\",\\n\\t\\t\\t\\\"\\\",\\n\\t\\t\\t\\\"def $1():\\\",\\n\\t\\t\\t\\\"    \\\\\\\"\\\\\\\"\\\\\\\"function synapses.\\\",\\n\\t\\t\\t\\\"    \\\",\\n\\t\\t\\t\\\"    description\\\",\\n\\t\\t\\t\\\"    \\\",\\n\\t\\t\\t\\\"    Args:\\\",\\n\\t\\t\\t\\\"        --None--\\\",\\n\\t\\t\\t\\\"    \\\",\\n\\t\\t\\t\\\"    Returns:\\\",\\n\\t\\t\\t\\\"        --None--\\\",\\n\\t\\t\\t\\\"    \\\",\\n\\t\\t\\t\\\"    Raises:\\\",\\n\\t\\t\\t\\\"        --None--\\\",\\n\\t\\t\\t\\\"    \\\",\\n\\t\\t\\t\\\"    \\\\\\\"\\\\\\\"\\\\\\\"\\\",\\n\\t\\t\\t\\\"\\\"\\n\\t\\t]\\n\\t},\\n\\t\\\"def_main\\\": {\\n\\t\\t\\\"prefix\\\": \\\"def_main\\\",\\n\\t\\t\\\"description\\\": \\\"Inserts templated main function and call\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"\\\",\\n\\t\\t\\t\\\"\\\",\\n\\t\\t\\t\\\"def main():\\\",\\n\\t\\t\\t\\\"    \\\\\\\"\\\\\\\"\\\\\\\"main function to call only when executed directly, useful for unit tests.\\\\\\\"\\\\\\\"\\\\\\\"\\\",\\n\\t\\t\\t\\\"    # executions code goes here\\\",\\n\\t\\t\\t\\\"\\\",\\n\\t\\t\\t\\\"\\\",\\n\\t\\t\\t\\\"if __name__ == '__main__':\\\",\\n\\t\\t\\t\\\"    main()\\\",\\n\\t\\t\\t\\\"\\\"\\n\\t\\t]\\n\\t},\\n\\t\\\"ExitScript\\\":{\\n\\t\\t\\\"description\\\": \\\"Exit the script with a message\\\",\\n\\t\\t\\\"prefix\\\": \\\"_exitScript\\\",\\n\\t\\t\\\"body\\\": \\\"sys.exit(\\\\\\\"$TM_FILENAME_BASE: Ended here\\\\\\\")\\\"\\n\\t},\\n\\t\\\"shebang\\\": {\\n\\t\\t\\\"prefix\\\": \\\"shebang\\\",\\n\\t\\t\\\"description\\\": \\\"Inserts the recommended Shebang line\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"#!/usr/bin/env python3\\\",\\n\\t\\t\\t\\\"\\\"\\n\\t\\t]\\n\\t},\\n\\t\\\"raiseException\\\":{\\n\\t\\t\\\"prefix\\\": \\\"raiseEx\\\",\\n\\t\\t\\\"description\\\": \\\"Raise an exception\\\",\\n\\t\\t\\\"body\\\": \\\"raise Exception(\\\\\\\"[$TM_FILENAME_BASE] ${1:message}\\\\\\\")\\\"\\n\\t},\\n\\t\\\"p_msg\\\":{\\n\\t\\t\\\"prefix\\\": \\\"p_msg\\\",\\n\\t\\t\\\"description\\\": \\\"Print message with date time\\\",\\n\\t\\t\\\"body\\\": \\\"print(datetime.datetime.now(), \\\\\\\"[$TM_FILENAME_BASE]\\\\\\\", \\\\\\\"*** $1....\\\\\\\")\\\"\\n\\t},\\n\\t\\\"p_msgSep\\\":{\\n\\t\\t\\\"prefix\\\": \\\"p_msgSep\\\",\\n\\t\\t\\\"description\\\": \\\"Print message separator with date time\\\",\\n\\t\\t\\\"body\\\": \\\"print(datetime.datetime.now(), \\\\\\\"[$TM_FILENAME_BASE]\\\\\\\", \\\\\\\"--------------------------------------------------------------------------\\\\\\\")\\\"\\n\\t},\\n\\t\\\"p_msgWarn\\\":{\\n\\t\\t\\\"prefix\\\": \\\"p_msgWarn\\\",\\n\\t\\t\\\"description\\\": \\\"Print warning message with date time\\\",\\n\\t\\t\\\"body\\\": \\\"print(datetime.datetime.now(), \\\\\\\"[$TM_FILENAME_BASE] WARNING \\\\\\\", \\\\\\\"*** $1....\\\\\\\")\\\"\\n\\t},\\n\\t\\\"p_msg-env\\\":{\\n\\t\\t\\\"prefix\\\": \\\"p_msg-env\\\",\\n\\t\\t\\\"description\\\": \\\"Print env variable name: value\\\",\\n\\t\\t\\\"body\\\": \\\"print(datetime.datetime.now(), \\\\\\\"[$TM_FILENAME_BASE]\\\\\\\", '* $1:', os.getenv('$1'))\\\"\\n\\t},\\n\\t\\\"todo\\\":{\\n\\t\\t\\\"prefix\\\": \\\"todo\\\",\\n\\t\\t\\\"description\\\": \\\"Add a TODO: comment\\\",\\n\\t\\t\\\"body\\\": \\\"# TODO: $0\\\"\\n\\t},\\n    \\\"FileNameAsComment\\\": {\\n        \\\"description\\\": \\\"Adds the script file name as a comment line\\\",\\n        \\\"prefix\\\": \\\"filename_comment\\\",\\n        \\\"body\\\": [\\n\\t\\t\\t\\\"# File: ${TM_DIRECTORY}/$TM_FILENAME\\\",\\n\\t\\t\\t\\\"# -----  C:/Python312/python.exe ./${TM_DIRECTORY}/$TM_FILENAME\\\"\\n\\t\\t]\\n    },\\n\\t\\\"libImportFromDir\\\":{\\n\\t\\t\\\"description\\\": \\\"Example code to import a bespoke lib module in another folder\\\",\\n\\t\\t\\\"prefix\\\": \\\"_libImportFromDir\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"# ----------\\\",\\n\\t\\t\\t\\\"import importlib.util\\\",\\n\\t\\t\\t\\\"import os\\\",\\n\\t\\t\\t\\\"import sys\\\",\\n\\t\\t\\t\\\"import datetime\\\",\\n\\t\\t\\t\\\"from pathlib import Path\\\",\\n\\t\\t\\t\\\"# Find the library file from root\\\",\\n\\t\\t\\t\\\"repoRoot = os.path.normpath(os.path.join(os.path.dirname(__file__),'../../'))\\\",\\n\\t\\t\\t\\\"libFiles = Path(repoRoot).rglob('devopsutils.py')\\\",\\n\\t\\t\\t\\\"for libFile in libFiles:\\\",\\n\\t\\t\\t\\\"    print(libFile.parent)\\\",\\n\\t\\t\\t\\\"\\\",\\n\\t\\t\\t\\\"if libFile == None:\\\",\\n\\t\\t\\t\\\"    raise Exception((\\\\\\\"[$TM_FILENAME_BASE] Unable to find 'devopsutils.py' from {repoRoot}\\\\\\\").format(repoRoot=repoRoot))\\\",\\n\\t\\t\\t\\\"else:\\\",\\n\\t\\t\\t\\\"    print(datetime.datetime.now(), '[$TM_FILENAME_BASE]', ('Found devopsutils.py from {repoRoot}').format(repoRoot=repoRoot))\\\",\\n\\t\\t\\t\\\"\\\",\\n\\t\\t\\t\\\"print('---libFile:  %s' % libFile)\\\",\\n\\t\\t\\t\\\"libSpec = importlib.util.spec_from_file_location('devopsutils', libFile)\\\",\\n\\t\\t\\t\\\"print('---libSpec: %s' % libSpec)\\\",\\n\\t\\t\\t\\\"devopsLib = importlib.util.module_from_spec(libSpec)\\\",\\n\\t\\t\\t\\\"sys.modules['devopsutils'] = devopsLib\\\",\\n\\t\\t\\t\\\"libSpec.loader.exec_module(devopsLib)\\\",\\n\\t\\t\\t\\\"defaultConfig = {\\\",\\n\\t\\t\\t\\\"    \\\\\\\"default\\\\\\\": {\\\",\\n\\t\\t\\t\\\"        \\\\\\\"DemoNames\\\\\\\": ['interactive','managedId'],\\\",\\n\\t\\t\\t\\\"    },\\\",\\n\\t\\t\\t\\\"    \\\\\\\"paths\\\\\\\": {\\\\\\\"OutputFolder\\\\\\\": \\\\\\\".temp\\\\\\\"},\\\",\\n\\t\\t\\t\\\"    \\\\\\\"AzCliConfig\\\\\\\": {\\\\\\\"resetBroker\\\\\\\": \\\\\\\"no\\\\\\\", \\\\\\\"core.login_experience_v2\\\\\\\": \\\\\\\"off\\\\\\\"},\\\",\\n\\t\\t\\t\\\"}\\\",\\n\\t\\t\\t\\\"genIni = devopsLib.genIniConfig(__file__.replace(\\\\\\\".py\\\\\\\", \\\\\\\".ini\\\\\\\"), defaultConfig)\\\",\\n\\t\\t\\t\\\"# ----------\\\"\\n\\t\\t]\\n\\t}\\n\\n}\",\"shellscript.json\":\"{\\n\\t// Place your snippets for shellscript here. Each snippet is defined under a snippet name and has a prefix, body and \\n\\t// description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:\\n\\t// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the \\n\\t// same ids are connected.\\n\\t// Example:\\n\\t// \\\"Print to console\\\": {\\n\\t// \\t\\\"prefix\\\": \\\"log\\\",\\n\\t// \\t\\\"body\\\": [\\n\\t// \\t\\t\\\"console.log('$1');\\\",\\n\\t// \\t\\t\\\"$2\\\"\\n\\t// \\t],\\n\\t// \\t\\\"description\\\": \\\"Log output to console\\\"\\n\\t// }\\n\\t\\\"Process Parameters\\\":{\\n\\t\\t\\\"prefix\\\": \\\"_paramsParse\\\",\\n\\t\\t\\\"description\\\": \\\"Create a loop to process parameters\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"while [ ! -z '$1' ]; do\\\",\\n            \\\"    case '$${1}' in\\\",\\n            \\\"    -b | --binaryName)\\\",\\n            \\\"        shift\\\",\\n            \\\"        binName='$${1}'\\\",\\n            \\\"        ;;\\\",\\n            \\\"    -a | --appName)\\\",\\n            \\\"        shift\\\",\\n            \\\"        AppName='$${1}'\\\",\\n            \\\"        ;;\\\",\\n            \\\"    -v | --version)\\\",\\n            \\\"        shift\\\",\\n            \\\"        AppVersion='$${1}'\\\",\\n            \\\"        ;;\\\",\\n            \\\"    *)\\\",\\n            \\\"        show_usage\\\",\\n            \\\"        ;;\\\",\\n            \\\"    esac\\\",\\n            \\\"    shift\\\",\\n            \\\"done\\\",\\n\\t\\t]\\n\\t},\\n    \\\"Test is variable empty\\\": {\\n        \\\"description\\\": \\\"Test if variable is null/empty\\\",\\n        \\\"prefix\\\": \\\"test-empty-vat\\\",\\n        \\\"body\\\": [\\n            \\\"if [[ -z '$${binName}' ]]; then\\\",\\n            \\\"    # ----Do what you neet\\\",\\n            \\\"fi\\\"\\n        ]\\n    },\\n    \\\"Set Script name for logging\\\":{\\n        \\\"description\\\": \\\"Set the variable 'thisSriptName'\\\",\\n        \\\"prefix\\\": \\\"log_scriptName\\\",\\n        \\\"body\\\": \\\"thisSriptName=$(basename '$${0}')\\\"\\n    },\\n    \\\"Add logging message\\\":{\\n        \\\"description\\\": \\\"Add a echo message using current script name\\\",\\n        \\\"prefix\\\": \\\"log_with_scriptmame\\\",\\n        \\\"body\\\": \\\"echo '[$${thisSriptName}] '\\\"\\n    },\\n    \\\"Load Common Functions\\\":{\\n        \\\"description\\\": \\\"Load common functions.sh from script path\\\",\\n        \\\"prefix\\\": \\\"bash_LoadCommonFunctions\\\",\\n        \\\"body\\\": [\\n            \\\"current_dir=\\\\\\\\${PWD}\\\",\\n            \\\"echo \\\\\\\"\\\\\\\\$current_dir\\\\\\\"\\\",\\n            \\\"SCRIPT_DIR=\\\\\\\\$( cd -- \\\\\\\"\\\\\\\\$( dirname -- \\\\\\\"\\\\\\\\${BASH_SOURCE[0]}\\\\\\\" )\\\\\\\" &> /dev/null && pwd )\\\",\\n            \\\"# shellcheck disable=SC2164\\\",\\n            \\\"cd \\\\\\\"\\\\\\\\$SCRIPT_DIR\\\\\\\"\\\",\\n            \\\"# shellcheck disable=SC1091\\\",\\n            \\\"source ./commonFunc.sh\\\",\\n            \\\"# shellcheck disable=SC2164\\\",\\n            \\\"cd \\\\\\\"\\\\\\\\$current_dir\\\\\\\"\\\",\\n            \\\"printf \\\\\\\"# -----------------------\\\\\\\"\\\"\\n        ]\\n    }\\n}\",\"terraform.json\":\"{\\n\\t// Place your snippets for terraform here. Each snippet is defined under a snippet name and has a prefix, body and\\n\\t// description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:\\n\\t// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the\\n\\t// same ids are connected.\\n\\t// Example:\\n\\t// \\\"Print to console\\\": {\\n\\t// \\t\\\"prefix\\\": \\\"log\\\",\\n\\t// \\t\\\"body\\\": [\\n\\t// \\t\\t\\\"console.log('$1');\\\",\\n\\t// \\t\\t\\\"$2\\\"\\n\\t// \\t],\\n\\t// \\t\\\"description\\\": \\\"Log output to console\\\"\\n\\t// }\\n    \\\"2-DO Comment\\\": {\\n        \\\"prefix\\\": \\\"2DO Comment\\\",\\n        \\\"description\\\": \\\"Add a TODO comment\\\",\\n        \\\"body\\\": \\\"# TODO: $1\\\"\\n\\t},\\n    \\\"2-DO Comment\\\": {\\n        \\\"prefix\\\": \\\"2DO Module Candidate\\\",\\n        \\\"description\\\": \\\"Add a TODO comment for module candidate\\\",\\n        \\\"body\\\": \\\"# TODO: Candidate for moving / using a module\\\"\\n\\t},\\n\\t\\\"tflint-ignore-line\\\":{\\n\\t\\t\\\"description\\\": \\\"Add comment to ignore tflint rule on next line\\\",\\n\\t\\t\\\"prefix\\\": \\\"tflint-ignore-line\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"# TODO: Review tflint-ignore ${0:rulename}\\\",\\n\\t\\t\\t\\\"# tflint-ignore: ${0:rulename}\\\"\\n\\t\\t]\\n\\t},\\n\\t\\\"tflint-ignore-line-unused-declarations\\\":{\\n\\t\\t\\\"description\\\": \\\"Add comment to ignore tflint rule unused_declarations on next line\\\",\\n\\t\\t\\\"prefix\\\": \\\"tflint-ignore-line-unused-declarations\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"# TODO: Review tflint-ignore terraform_unused_declarations\\\",\\n\\t\\t\\t\\\"# tflint-ignore: terraform_unused_declarations\\\"\\n\\t\\t]\\n\\t},\\n\\t\\\"tflint-ignore-file\\\":{\\n\\t\\t\\\"description\\\": \\\"Add comment to ignore tflint rule in current file\\\",\\n\\t\\t\\\"prefix\\\": \\\"tflint-ignore-file\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"# TODO: Review tflint Ignore\\\",\\n\\t\\t\\t\\\"# tflint-ignore-file: ${0:rulename}\\\"\\n\\t\\t]\\n\\t},\\n\\t\\\"tf-block-comment\\\":\\t{\\n\\t\\t\\\"description\\\": \\\"Add block comment around selected text\\\",\\n\\t\\t\\\"prefix\\\": \\\"tf-block-comment\\\",\\n\\t\\t\\\"body\\\": [\\n\\t\\t\\t\\\"${BLOCK_COMMENT_START} -----------------------\\\",\\n\\t\\t\\t\\\"${TM_SELECTED_TEXT}\\\",\\n\\t\\t\\t\\\"#   ----------------------- ${BLOCK_COMMENT_END}\\\"\\n\\t\\t]\\n\\n\\t}\\n}\",\"yaml.json\":\"{\\n    // Place your snippets for yaml here. Each snippet is defined under a snippet name and has a prefix, body and\\n    // description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:\\n    // $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the\\n    // same ids are connected.\\n    // Example:\\n    // \\\"Print to console\\\": {\\n    // \\t\\\"prefix\\\": \\\"log\\\",\\n    // \\t\\\"body\\\": [\\n    // \\t\\t\\\"console.log('$1');\\\",\\n    // \\t\\t\\\"$2\\\"\\n    // \\t],\\n    // \\t\\\"description\\\": \\\"Log output to console\\\"\\n    // }\\n    \\\"_AzDoStepPipelineTemplateBasic\\\": {\\n        \\\"prefix\\\": \\\"_AzDoScriptTemplateBasic\\\",\\n        \\\"description\\\": \\\"Azure Pipelines YAML Template Basic starter\\\",\\n        \\\"body\\\": [\\n            \\\"# File: ${TM_DIRECTORY}/${TM_FILENAME}\\\",\\n            \\\"parameters:\\\",\\n            \\\"- name: yesNo # name of the parameter; required\\\",\\n            \\\"  type: boolean # data type of the parameter; required\\\",\\n            \\\"  default: false\\\",\\n            \\\"\\\",\\n            \\\"steps:\\\",\\n            \\\"- script: echo ${{ parameters.yesNo}}\\\"\\n        ]\\n    },\\n    \\\"_AzDOFileNameComment\\\": {\\n        \\\"prefix\\\": \\\"_AzDOFileNameComment\\\",\\n        \\\"description\\\": \\\"Azure Pipelines YAML Add filename comment\\\",\\n        \\\"body\\\": [\\n            \\\"# File: ${RELATIVE_FILEPATH}\\\"\\n        ]\\n    },\\n    \\\"_AzDoPipelineTemplateBasic\\\": {\\n        \\\"prefix\\\": \\\"_AzDoPipelineTemplateBasic\\\",\\n        \\\"description\\\": \\\"Azure Pipelines YAML Basic starter\\\",\\n        \\\"body\\\": [\\n            \\\"# File: ${TM_DIRECTORY}/${TM_FILENAME}\\\",\\n            \\\"# Starter pipeline\\\",\\n            \\\"# Start with a minimal pipeline that you can customize to build and deploy your code.\\\",\\n            \\\"# Add steps that build, run tests, deploy, and more:\\\",\\n            \\\"# https://aka.ms/yaml\\\",\\n            \\\"\\\",\\n            \\\"trigger:\\\",\\n            \\\"- main\\\",\\n            \\\"\\\",\\n            \\\"pool:\\\",\\n            \\\"  vmImage: ubuntu-latest\\\",\\n            \\\"\\\",\\n            \\\"steps:\\\",\\n            \\\"- script: echo Hello, world!\\\",\\n            \\\"  displayName: 'Run a one-line script'\\\",\\n        ]\\n    },\\n    \\\"_AzDoStarterPipeline\\\": {\\n        \\\"prefix\\\": \\\"_AzDoStarterPipeline\\\",\\n        \\\"description\\\": \\\"Minimal starter pipeline\\\",\\n        \\\"body\\\": [\\n            \\\"# Starter pipeline\\\",\\n            \\\"# Start with a minimal pipeline that you can customize to build and deploy your code.\\\",\\n            \\\"# Add steps that build, run tests, deploy, and more:\\\",\\n            \\\"# https: //aka.ms/yaml\\\",\\n            \\\"\\\",\\n            \\\"trigger:\\\",\\n            \\\"- main\\\",\\n            \\\"pool:\\\",\\n            \\\"  vmImage: ubuntu-latest\\\",\\n            \\\"\\\",\\n            \\\"steps:\\\",\\n            \\\"- script: echo Hello, world!\\\",\\n            \\\"  displayName: 'Run a one-line script'\\\",\\n            \\\"\\\",\\n            \\\"- script: |\\\",\\n            \\\"    echo Add other tasks to build, test, and deploy your project.\\\",\\n            \\\"    echo See https: //aka.ms/yaml\\\",\\n            \\\"  displayName: 'Run a multi-line script'\\\",\\n            \\\"\\\"\\n        ]\\n    },\\n    \\\"_AzDoParameterPlaceholder\\\":{\\n        \\\"prefix\\\": \\\"_AzDoParameterPlaceholder\\\",\\n        \\\"description\\\": \\\"Insert a parameter placeholder into YAML pipeline/template\\\",\\n        \\\"body\\\": \\\"${{ parameters.$0 }}\\\"\\n    },\\n    \\\"_AzDoVariablePlaceholder\\\":{\\n        \\\"prefix\\\": \\\"_AzDoVariablePlaceholder\\\",\\n        \\\"description\\\": \\\"Insert a variable placeholder into YAML pipeline/template\\\",\\n        \\\"body\\\": \\\"${{ variables.$0 }}\\\"\\n    },\\n    \\\"_AzCliInline\\\":{\\n        \\\"description\\\": \\\"Azure Cli inline task\\\",\\n        \\\"prefix\\\": \\\"_AzCliInline\\\",\\n        \\\"body\\\": [\\n            \\\"- task: AzureCLI@2\\\",\\n            \\\"  displayName: 'Create Common Resource Group'\\\",\\n            \\\"  inputs:\\\",\\n            \\\"    azureSubscription: '$(az-common-ServiceAccount)'\\\",\\n            \\\"    scriptType: 'pscore'\\\",\\n            \\\"    scriptLocation: 'inlineScript'\\\",\\n            \\\"    inlineScript: |\\\",\\n            \\\"      \\\\\\\\$rgExist = az group exists -g $(az-common-rg)\\\",\\n            \\\"      if (\\\\\\\\$rgExist -eq 'false') {\\\",\\n            \\\"        Write-Host 'Create resource Group: $(az-common-rg)'\\\",\\n            \\\"        az group create --location $(az-common-location) -g $(az-common-rg) --tags env=common RAISE-PREC\\\",\\n            \\\"      } else {\\\",\\n            \\\"        Write-Host 'Found resource Group: $(az-common-rg)'\\\",\\n            \\\"      }\\\",\\n            \\\"  env:\\\",\\n            \\\"    SYSTEM_ACCESSTOKEN: $(System.AccessToken)\\\",\\n            \\\"  enabled: true\\\"\\n        ]\\n    },\\n    \\\"_AzDoAzPwshInline\\\":{\\n        \\\"prefix\\\": \\\"AzPwsh-Inline-Task\\\",\\n        \\\"description\\\": \\\"Azure PowerShell Inline Script Task\\\",\\n        \\\"body\\\": [\\n            \\\"- task: AzurePowerShell@5\\\",\\n            \\\"  displayName: 'Execute inline Azure PowerShell Script'\\\",\\n            \\\"  inputs:\\\",\\n            \\\"    azureSubscription: '${{ parameters.azureSubscription }}'\\\",\\n            \\\"    ScriptType: 'InlineScript'\\\",\\n            \\\"    Inline: |\\\",\\n            \\\"      # Script code goes here\\\",\\n            \\\"    azurePowerShellVersion: 'LatestVersion'\\\",\\n            \\\"    pwsh: true\\\",\\n            \\\"  env:\\\",\\n            \\\"    SYSTEM_ACCESSTOKEN: $(System.AccessToken)\\\"\\n        ]\\n    },\\n    \\\"_AzDoAzPwshScript\\\":{\\n        \\\"prefix\\\": \\\"AzPwsh-Script-Task\\\",\\n        \\\"description\\\": \\\"Azure PowerShell Script Task\\\",\\n        \\\"body\\\": [\\n            \\\"- task: AzurePowerShell@5\\\",\\n            \\\"  inputs:\\\",\\n            \\\"   azureSubscription: '${{ parameters.SvcAccount }}'\\\",\\n            \\\"   ScriptType: 'FilePath'\\\",\\n            \\\"   ScriptPath: '$(Script.File.Path)'\\\",\\n            \\\"   ScriptArguments:\\\",\\n            \\\"     -Arg1 'Value1'\\\",\\n            \\\"   azurePowerShellVersion: 'LatestVersion'\\\",\\n            \\\"   pwsh: true\\\",\\n            \\\"  env:\\\",\\n            \\\"    SYSTEM_ACCESSTOKEN: $(System.AccessToken)\\\"\\n        ]\\n    },\\n    \\\"_temp-SearchFilesPath\\\":{\\n        \\\"description\\\": \\\"Insert template: step-Search-Files-Path.yml@templates\\\",\\n        \\\"prefix\\\": \\\"_temp-SearchFilesPath\\\",\\n        \\\"body\\\": [\\n            \\\"# --------------------------------------\\\",\\n            \\\"- template: step-Search-Files-Path.yml@templates\\\",\\n            \\\"  parameters:\\\",\\n            \\\"    FileNames:\\\",\\n            \\\"    - Name: 'filename.xxx'\\\",\\n            \\\"      VarName: 'filename.File.Path'\\\",\\n            \\\"    RootFolder: $(Build.SourcesDirectory)\\\",\\n            \\\"    ReturnFullPath: true\\\",\\n            \\\"# --------------------------------------\\\",\\n        ]\\n    },\\n    \\\"filename_comment\\\":{\\n        \\\"prefix\\\": \\\"filename_comment\\\",\\n        \\\"description\\\": \\\"Adds a comment with the full file name\\\",\\n        \\\"body\\\": [\\n            \\\"# File: ${TM_DIRECTORY}/${TM_FILENAME}\\\"\\n        ]\\n    },\\n    \\\"template-filename-comment\\\":{\\n        \\\"prefix\\\": \\\"file_template_comment\\\",\\n        \\\"description\\\": \\\"Adds a comment with the full file name\\\",\\n        \\\"body\\\": [\\n            \\\"# File: ${TM_FILENAME}@templates\\\",\\n            \\\"# --------------------------------------\\\",\\n            \\\"#   - template: ${TM_FILENAME}@templates\\\",\\n            \\\"#     parameters:\\\",\\n            \\\"#       ShowParams: ${{ parameters.ShowParams }}\\\",\\n            \\\"#       p_name: 'p_value'\\\",\\n            \\\"# --------------------------------------\\\",\\n            \\\"parameters:\\\",\\n            \\\"- name: p_name\\\",\\n            \\\"  type: string\\\",\\n            \\\"  default: 'p_value'\\\",\\n            \\\"- name: ShowParams\\\",\\n            \\\"  type: boolean\\\",\\n            \\\"  default: false\\\",\\n            \\\"# --------------------------------------\\\",\\n            \\\"steps:\\\",\\n            \\\"- template: step-debug-show-template-params.yml\\\",\\n            \\\"  parameters:\\\",\\n            \\\"    TemplateName: '${TM_FILENAME}'\\\",\\n            \\\"    enabled: ${{ parameters.ShowParams }}\\\",\\n            \\\"    SaveParamsToFile: false\\\",\\n            \\\"    paramValues:\\\",\\n            \\\"      p_name1: '${{ parameters.p_name1 }}'\\\",\\n            \\\"      p_name2: '${{ parameters.p_name2 }}'\\\",\\n            \\\"      p_name3: '${{ parameters.p_name3 }}'\\\",\\n            \\\"# --------------------------------------\\\"\\n        ]\\n    },\\n    \\\"Ac_Cli_Script_Task\\\":{\\n        \\\"prefix\\\": \\\"AzCli-Script-Task\\\",\\n        \\\"description\\\": \\\"Azure CLI script task\\\",\\n        \\\"body\\\": [\\n            \\\"- task: AzureCLI@2\\\",\\n            \\\"  inputs:\\\",\\n            \\\"    azureSubscription: '${1: azureSubscription}'\\\",\\n            \\\"    scriptType: 'pscore'\\\",\\n            \\\"    scriptLocation: 'scriptPath'\\\",\\n            \\\"    scriptPath: '${2: Path}'\\\",\\n            \\\"    arguments: '-${3: arg1} ${0: Value1}'\\\",\\n            \\\"    useGlobalConfig: true\\\",\\n            \\\"  enabled: true\\\",\\n            \\\"  env:\\\",\\n            \\\"    SYSTEM_ACCESSTOKEN: $(System.AccessToken)\\\"\\n        ]\\n    },\\n    \\\"Az Cli Inline Task\\\":{\\n        \\\"prefix\\\": \\\"AzCli-Inline-Task\\\",\\n        \\\"description\\\": \\\"Azure CLI Inline script task\\\",\\n        \\\"body\\\": [\\n            \\\"- task: AzureCLI@2\\\",\\n            \\\"  displayName: ${1:description}\\\",\\n            \\\"  inputs:\\\",\\n            \\\"    azureSubscription: '${{ parameters.azureSubscription }}'\\\",\\n            \\\"    scriptType: 'pscore'\\\",\\n            \\\"    scriptLocation: 'inlineScript'\\\",\\n            \\\"    inlineScript: |\\\",\\n            \\\"      '# $$Arg1 here'\\\",\\n            \\\"    arguments: '-Arg1 Value1'\\\",\\n            \\\"    addSpnToEnvironment: true\\\",\\n            \\\"    useGlobalConfig: true\\\",\\n            \\\"    failOnStandardError: true\\\",\\n            \\\"    powerShellIgnoreLASTEXITCODE: false\\\",\\n            \\\"  env:\\\",\\n            \\\"    SYSTEM_ACCESSTOKEN: $(System.AccessToken)\\\"\\n        ]\\n    },\\n    \\\"Cmdline Task\\\":{\\n        \\\"prefix\\\": \\\"cmdline-Inline-Task\\\",\\n        \\\"description\\\": \\\"Run bash/cmd inline script\\\",\\n        \\\"body\\\": [\\n            \\\"- task: CmdLine@2\\\",\\n            \\\"  displayName: description\\\",\\n            \\\"  inputs:\\\",\\n            \\\"  script: |\\\",\\n            \\\"    echo Write your commands here\\\",\\n            \\\"    echo Hello world\\\"\\n        ]\\n    },\\n    \\\"CopyFile_Task\\\":{\\n        \\\"description\\\": \\\"Add a simple file copy task\\\",\\n        \\\"prefix\\\": \\\"copyfile-task\\\",\\n        \\\"body\\\": [\\n            \\\"- task: CopyFiles@2\\\",\\n            \\\"  displayName: Copy files from source to target\\\",\\n            \\\"  inputs:\\\",\\n            \\\"    SourceFolder: '$$(agent.builddirectory)'\\\",\\n            \\\"    Contents: '**'\\\",\\n            \\\"    TargetFolder: '$$(build.artifactstagingdirectory)'\\\",\\n            \\\"    CleanTargetFolder: false\\\",\\n            \\\"    OverWrite: true\\\",\\n            \\\"    flattenFolders: false\\\",\\n            \\\"    retryCount: '3'\\\",\\n            \\\"  enabled: true\\\"\\n        ]\\n    },\\n    \\\"Debug-TemplateInline-ShowParams-Debug-Task\\\":{\\n        \\\"description\\\": \\\"Template to display paraeters in a template\\\",\\n        \\\"prefix\\\": \\\"debug-template-showparams\\\",\\n        \\\"body\\\": [\\n            \\\"# ----------------------------------------------------------\\\",\\n            \\\"#       ShowParams: true\\\",\\n            \\\"#  - name: ShowParams\\\",\\n            \\\"#    type: boolean\\\",\\n            \\\"#    default: false\\\",\\n            \\\"- template: step-debug-show-template-params.yml\\\",\\n            \\\"  parameters:\\\",\\n            \\\"    TemplateName: '${TM_FILENAME}'\\\",\\n            \\\"    enabled: ${{ parameters.ShowParams }}\\\",\\n            \\\"    SaveParamsToFile: false\\\",\\n            \\\"    paramValues:\\\",\\n            \\\"      p_name1: '${{ parameters.p_name1 }}'\\\",\\n            \\\"      p_name2: '${{ parameters.p_name2 }}'\\\",\\n            \\\"      p_name3: '${{ parameters.p_name3 }}'\\\",\\n            \\\"# ----------------------------------------------------------\\\"\\n        ]\\n    },\\n    \\\"paramImage\\\":{\\n        \\\"description\\\": \\\"Parameter to select a image\\\",\\n        \\\"prefix\\\": \\\"_paramImage\\\",\\n        \\\"body\\\": [\\n            \\\"  - name: image\\\",\\n            \\\"    displayName: Pool Image\\\",\\n            \\\"    type: string\\\",\\n            \\\"    default: windows-latest\\\",\\n            \\\"    values:\\\",\\n            \\\"      - windows-latest\\\",\\n            \\\"      - ubuntu-latest\\\",\\n            \\\"      - macOS-latest\\\"\\n        ]\\n    },\\n    \\\"Publish_Artifacts\\\":{\\n        \\\"description\\\": \\\"Task to publish build artifacts\\\",\\n        \\\"prefix\\\": \\\"_publishArtTask\\\",\\n        \\\"body\\\": [\\n            \\\"- task: PublishBuildArtifacts@1\\\",\\n            \\\"  displayName: 'Publish files from $(Build.ArtifactStagingDirectory)'\\\",\\n            \\\"  inputs:\\\",\\n            \\\"    PathtoPublish: '$(Build.ArtifactStagingDirectory)'\\\",\\n            \\\"    ArtifactName: 'drop'\\\",\\n            \\\"    publishLocation: 'Container'\\\",\\n            \\\"    StoreAsTar: false\\\",\\n            \\\"  enabled: true\\\"\\n        ]\\n    },\\n    \\\"Pwsh-Script-Task\\\":{\\n        \\\"description\\\": \\\"Run a powershell Core Script\\\",\\n        \\\"prefix\\\": \\\"pwsh-script-task\\\",\\n        \\\"body\\\": [\\n            \\\"- task: PowerShell@2\\\",\\n            \\\"  displayName: '${0:Powershell Task}''\\\",\\n            \\\"  inputs:\\\",\\n            \\\"    filePath: '$(System.DefaultWorkingDirectory)/Test.ps1'\\\",\\n            \\\"    arguments: -Arg1 'xxxxxx'\\\",\\n            \\\"    pwsh: true\\\",\\n            \\\"  enabled: true\\\",\\n            \\\"  env:\\\",\\n            \\\"    SYSTEM_ACCESSTOKEN: $(System.AccessToken)\\\"\\n\\n        ]\\n    },\\n    \\\"Pwsh-Inline-Task\\\":{\\n        \\\"description\\\": \\\"Run inline powershell Core Task\\\",\\n        \\\"prefix\\\": \\\"pwsh-inline-task\\\",\\n        \\\"body\\\": [\\n            \\\"- task: PowerShell@2\\\",\\n            \\\"  displayName: '${0:Powershell Task}'\\\",\\n            \\\"  inputs:\\\",\\n            \\\"    targetType: 'inline'\\\",\\n            \\\"    script: |\\\",\\n            \\\"      Write-Host 'Hello World'\\\",\\n            \\\"    showWarnings: true\\\",\\n            \\\"    pwsh: true\\\",\\n            \\\"  enabled: true\\\",\\n            \\\"  env:\\\",\\n            \\\"    AZURE_DEVOPS_EXT_PAT: $(System.AccessToken)\\\"\\n        ]\\n    },\\n    \\\"TODO Comment\\\": {\\n        \\\"body\\\": \\\"# TODO: ($CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE @$CURRENT_HOUR:$CURRENT_MINUTE:$CURRENT_SECOND): ${0: comment}\\\",\\n        \\\"description\\\": \\\"Add a TODO: Comment\\\",\\n        \\\"prefix\\\": \\\"TODO Comment\\\"\\n    },\\n    \\\"TODO Secret\\\": {\\n        \\\"body\\\": \\\"# TODO: ($CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE @$CURRENT_HOUR:$CURRENT_MINUTE:$CURRENT_SECOND): This looks like it needs to be move to a Group/Library\\\",\\n        \\\"description\\\": \\\"Add a TODO: Comment\\\",\\n        \\\"prefix\\\": \\\"TODO Secret\\\"\\n    }\\n}\"}}",
